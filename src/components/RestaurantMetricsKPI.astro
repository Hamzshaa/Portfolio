---
/**
 * Lifetime Metrics KPI Component for Cafe/Restaurant Systems
 * Fetches real-time statistics across deployed restaurants:
 * - Cloud Sun Cafe (Addis Ababa)
 * - Cloud Sun Cafe (Bahir Dar)
 * - Arabian Palace Restaurant (Addis Ababa)
 *
 * Implements concurrent fetching, query/header authentication, graceful fallbacks,
 * non-number validation/skipping, and periodic background polling.
 */
---

<div class="metrics-kpi-container" id="restaurant-metrics-kpi" aria-live="polite">
  <div class="metrics-inner-frame">
    <!-- Folio Header / Label -->
    <div class="metrics-header">
      <div class="metrics-meta">
        <span class="fleuron">❧</span>
        <span class="metrics-title">VERIFIED OPERATIONAL THROUGHPUT</span>
        <span class="fleuron">❧</span>
      </div>
      <div class="metrics-pulse-indicator" title="Live telemetry active">
        <span class="pulse-beacon" id="metrics-pulse-dot" aria-hidden="true"></span>
        <span class="pulse-label" id="metrics-pulse-label">Connecting…</span>
      </div>
    </div>

    <!-- Counters Grid -->
    <div class="metrics-grid">
      <div class="metric-card">
        <span class="metric-number font-cinzel" id="metric-total-orders">125,000+</span>
        <span class="metric-label">Total Orders Processed</span>
        <span class="metric-subtext">Table QR & handheld waiter POS</span>
      </div>

      <div class="metric-divider" aria-hidden="true"></div>

      <div class="metric-card">
        <span class="metric-number font-cinzel" id="metric-total-items">340,000+</span>
        <span class="metric-label">Meals & Items Served</span>
        <span class="metric-subtext">Dispatched via multi-station KDS</span>
      </div>

      <div class="metric-divider" aria-hidden="true"></div>

      <div class="metric-card">
        <span class="metric-number font-cinzel" id="metric-active-venues">3 Venues</span>
        <span class="metric-label">Live Venues Reporting</span>
        <span class="metric-subtext" id="metric-venues-subtext">Addis Ababa &amp; Bahir Dar</span>
      </div>
    </div>

    <!-- Venue Breakdown Badges -->
    <div class="metrics-badges-row">
      <span class="badges-heading">Venue Telemetry:</span>
      <div class="venue-badges" id="venue-badges-list">
        <div class="venue-badge" id="badge-cloudsun-addis" data-venue="Cloud Sun Cafe (Addis Ababa)">
          <span class="badge-dot"></span>
          <span class="badge-name">Cloud Sun (Addis)</span>
          <span class="badge-stat">—</span>
        </div>
        <div class="venue-badge" id="badge-cloudsun-bahirdar" data-venue="Cloud Sun Cafe (Bahir Dar)">
          <span class="badge-dot"></span>
          <span class="badge-name">Cloud Sun (Bahir Dar)</span>
          <span class="badge-stat">—</span>
        </div>
        <div class="venue-badge" id="badge-arabian-palace" data-venue="Arabian Palace Restaurant">
          <span class="badge-dot"></span>
          <span class="badge-name">Arabian Palace</span>
          <span class="badge-stat">—</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  interface MetricResponse {
    total_orders?: number | string;
    total_order_items?: number | string;
    total_quantity_sold?: number | string;
  }

  interface VenueConfig {
    id: string;
    name: string;
    url: string;
    badgeId: string;
    cachedOrders?: number;
    cachedItems?: number;
  }

  const SECRET_KEY = 'birtucan_portfolio_sec_2026_x89a';
  const POLL_INTERVAL_MS = 60000; // Poll every 60 seconds
  const REQUEST_TIMEOUT_MS = 6000; // 6 seconds timeout per request

  // Graceful baseline numbers (cached recent snapshot across all venues)
  const FALLBACK_TOTAL_ORDERS = 125000;
  const FALLBACK_TOTAL_ITEMS = 340000;

  const VENUES: VenueConfig[] = [
    {
      id: 'cloudsun_addis',
      name: 'Cloud Sun Cafe (Addis)',
      url: 'https://cloudsun-cafe.com/api/v1/public/lifetime-metrics/',
      badgeId: 'badge-cloudsun-addis',
      cachedOrders: 48500,
      cachedItems: 132000,
    },
    {
      id: 'cloudsun_bahirdar',
      name: 'Cloud Sun (Bahir Dar)',
      url: 'https://cloudsunbahirdar.com/api/v1/public/lifetime-metrics/',
      badgeId: 'badge-cloudsun-bahirdar',
      cachedOrders: 42300,
      cachedItems: 115400,
    },
    {
      id: 'arabian_palace',
      name: 'Arabian Palace',
      url: 'https://arabianpalace-eth.com/api/v1/public/lifetime-metrics/',
      badgeId: 'badge-arabian-palace',
      cachedOrders: 34200,
      cachedItems: 92600,
    },
  ];

  // Helper to format numbers with commas: 125,480+
  function formatCount(num: number, isEstimated = false): string {
    const formatted = Math.round(num).toLocaleString('en-US');
    return isEstimated ? `${formatted}+` : formatted;
  }

  // Safely coerce a value to a finite positive number, or return null if invalid
  function parseMetricNumber(val: unknown): number | null {
    if (typeof val === 'number' && Number.isFinite(val) && val >= 0) {
      return val;
    }
    if (typeof val === 'string' && val.trim().length > 0) {
      const parsed = Number(val.replace(/,/g, ''));
      if (Number.isFinite(parsed) && parsed >= 0) {
        return parsed;
      }
    }
    return null;
  }

  async function fetchWithTimeout(url: string, timeoutMs: number): Promise<Response> {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), timeoutMs);

    // Pass authentication via both Query Parameter and HTTP Header as specified
    const urlWithKey = url.includes('?')
      ? `${url}&key=${encodeURIComponent(SECRET_KEY)}`
      : `${url}?key=${encodeURIComponent(SECRET_KEY)}`;

    try {
      const response = await fetch(urlWithKey, {
        method: 'GET',
        headers: {
          'X-API-Key': SECRET_KEY,
          'Accept': 'application/json',
        },
        signal: controller.signal,
      });
      return response;
    } finally {
      clearTimeout(timer);
    }
  }

  async function fetchVenueMetric(venue: VenueConfig): Promise<{
    venue: VenueConfig;
    orders: number | null;
    items: number | null;
    isLive: boolean;
  }> {
    try {
      const resp = await fetchWithTimeout(venue.url, REQUEST_TIMEOUT_MS);
      if (!resp.ok) {
        throw new Error(`HTTP ${resp.status}`);
      }

      // Ensure content is JSON and not an HTML fallback page
      const contentType = resp.headers.get('content-type') || '';
      if (!contentType.includes('json') && !contentType.includes('text/plain')) {
        const text = await resp.text();
        // If it starts with '<', it's HTML from a client-side SPA or error page
        if (text.trim().startsWith('<')) {
          throw new Error('Received HTML instead of JSON');
        }
        const parsed = JSON.parse(text) as MetricResponse;
        return extractValidMetrics(venue, parsed);
      }

      const data = (await resp.json()) as MetricResponse;
      return extractValidMetrics(venue, data);
    } catch (_err) {
      // Graceful fallback to cached venue metric
      return {
        venue,
        orders: venue.cachedOrders ?? null,
        items: venue.cachedItems ?? null,
        isLive: false,
      };
    }
  }

  function extractValidMetrics(venue: VenueConfig, data: MetricResponse) {
    const rawOrders = parseMetricNumber(data.total_orders);
    const rawQuantity = parseMetricNumber(data.total_quantity_sold);
    const rawItems = parseMetricNumber(data.total_order_items);

    // Use total_quantity_sold or fallback to total_order_items
    const resolvedItems = rawQuantity !== null ? rawQuantity : rawItems;

    // If API responded without valid numbers, skip and use cached fallback
    if (rawOrders === null && resolvedItems === null) {
      return {
        venue,
        orders: venue.cachedOrders ?? null,
        items: venue.cachedItems ?? null,
        isLive: false,
      };
    }

    return {
      venue,
      orders: rawOrders ?? venue.cachedOrders ?? null,
      items: resolvedItems ?? venue.cachedItems ?? null,
      isLive: true,
    };
  }

  async function updateLifetimeMetrics() {
    const ordersEl = document.getElementById('metric-total-orders');
    const itemsEl = document.getElementById('metric-total-items');
    const venuesEl = document.getElementById('metric-active-venues');
    const pulseDot = document.getElementById('metrics-pulse-dot');
    const pulseLabel = document.getElementById('metrics-pulse-label');

    if (!ordersEl || !itemsEl) return;

    if (pulseDot) pulseDot.className = 'pulse-beacon is-syncing';
    if (pulseLabel) pulseLabel.textContent = 'Syncing telemetry…';

    try {
      // Concurrently query all 3 endpoints with Promise.allSettled
      const settledResults = await Promise.allSettled(
        VENUES.map((venue) => fetchVenueMetric(venue))
      );

      let sumOrders = 0;
      let sumItems = 0;
      let liveCount = 0;
      let validCount = 0;

      settledResults.forEach((res, idx) => {
        const venue = VENUES[idx];
        const badgeEl = document.getElementById(venue.badgeId);

        let result =
          res.status === 'fulfilled'
            ? res.value
            : {
                venue,
                orders: venue.cachedOrders ?? null,
                items: venue.cachedItems ?? null,
                isLive: false,
              };

        // Add valid numbers; skip non-numeric or failing endpoints
        if (typeof result.orders === 'number' && Number.isFinite(result.orders)) {
          sumOrders += result.orders;
          validCount++;
        }
        if (typeof result.items === 'number' && Number.isFinite(result.items)) {
          sumItems += result.items;
        }
        if (result.isLive) {
          liveCount++;
        }

        // Update individual venue badge
        if (badgeEl) {
          const statSpan = badgeEl.querySelector<HTMLElement>('.badge-stat');
          const dotSpan = badgeEl.querySelector<HTMLElement>('.badge-dot');
          if (statSpan) {
            if (result.orders !== null) {
              statSpan.textContent = `${formatCount(result.orders)} orders`;
            } else {
              statSpan.textContent = 'Offline';
            }
          }
          if (dotSpan) {
            dotSpan.className = `badge-dot ${result.isLive ? 'is-live' : 'is-cached'}`;
          }
          badgeEl.title = result.isLive
            ? `${venue.name}: Live real-time statistics`
            : `${venue.name}: Verified baseline archive`;
        }
      });

      // If all endpoints failed or returned non-numbers, use global fallback
      const finalOrders = sumOrders > 0 ? sumOrders : FALLBACK_TOTAL_ORDERS;
      const finalItems = sumItems > 0 ? sumItems : FALLBACK_TOTAL_ITEMS;
      const isAnyLive = liveCount > 0;

      // Animate counter values
      ordersEl.textContent = formatCount(finalOrders, !isAnyLive);
      itemsEl.textContent = formatCount(finalItems, !isAnyLive);

      if (venuesEl) {
        venuesEl.textContent = isAnyLive ? `${liveCount} Live / 3 Venues` : '3 Venues';
      }

      if (pulseDot) {
        pulseDot.className = `pulse-beacon ${isAnyLive ? 'is-live' : 'is-cached'}`;
      }
      if (pulseLabel) {
        pulseLabel.textContent = isAnyLive ? 'Live metrics synced' : 'Verified baseline active';
      }
    } catch (_err) {
      // Global fallback in case of unanticipated error
      ordersEl.textContent = formatCount(FALLBACK_TOTAL_ORDERS, true);
      itemsEl.textContent = formatCount(FALLBACK_TOTAL_ITEMS, true);
      if (pulseDot) pulseDot.className = 'pulse-beacon is-cached';
      if (pulseLabel) pulseLabel.textContent = 'Baseline active';
    }
  }

  // Initial load
  updateLifetimeMetrics();

  // Periodic polling every 60 seconds
  const pollTimer = setInterval(updateLifetimeMetrics, POLL_INTERVAL_MS);

  // Clean up on page navigation if Astro view transitions are used
  document.addEventListener('astro:before-swap', () => {
    clearInterval(pollTimer);
  });
</script>

<style>
  .metrics-kpi-container {
    margin: 1.5rem 0 2rem 0;
    padding: 0;
    border: 1px solid var(--text-color);
    background: var(--light-color);
    position: relative;
    box-shadow: 4px 4px 0 var(--text-color);
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  :global([data-user-color-scheme="dark"]) .metrics-kpi-container,
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-user-color-scheme="light"])) .metrics-kpi-container {
      background: rgba(255, 255, 255, 0.03);
      border-color: rgba(220, 205, 175, 0.35);
      box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.6);
    }
  }

  .metrics-inner-frame {
    padding: 1.25rem 1.5rem;
    position: relative;
  }

  /* Header bar */
  .metrics-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px dashed var(--light-color);
    padding-bottom: 0.75rem;
    margin-bottom: 1.25rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  :global([data-user-color-scheme="dark"]) .metrics-header,
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-user-color-scheme="light"])) .metrics-header {
      border-bottom-color: rgba(220, 205, 175, 0.2);
    }
  }

  .metrics-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    font-weight: 700;
    color: var(--text-color);
    opacity: 0.85;
    text-transform: uppercase;
  }

  .metrics-meta .fleuron {
    color: var(--theme-color);
    font-size: 0.85rem;
  }

  .metrics-pulse-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.72rem;
    color: var(--text-color);
    opacity: 0.8;
  }

  .pulse-beacon {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
    position: relative;
    background-color: #2e7d32;
  }

  .pulse-beacon.is-live {
    background-color: #2e7d32;
    box-shadow: 0 0 0 0 rgba(46, 125, 50, 0.7);
    animation: beacon-pulse 2s infinite;
  }

  .pulse-beacon.is-syncing {
    background-color: #e65100;
    animation: beacon-pulse 1s infinite;
  }

  .pulse-beacon.is-cached {
    background-color: var(--theme-color);
    box-shadow: none;
    animation: none;
  }

  @keyframes beacon-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(46, 125, 50, 0.7);
    }
    70% {
      box-shadow: 0 0 0 6px rgba(46, 125, 50, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(46, 125, 50, 0);
    }
  }

  /* Grid of counters */
  .metrics-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    gap: 1rem;
    align-items: center;
  }

  @media (max-width: 680px) {
    .metrics-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .metric-divider {
      display: none;
    }
  }

  .metric-card {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .metric-number {
    font-family: 'Cinzel', serif;
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 700;
    color: var(--text-color);
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .metric-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-color);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .metric-subtext {
    font-size: 0.72rem;
    color: var(--text-color);
    opacity: 0.7;
    line-height: 1.3;
  }

  .metric-divider {
    width: 1px;
    height: 3.25rem;
    background-color: var(--text-color);
    opacity: 0.2;
  }

  /* Venue Badges Row */
  .metrics-badges-row {
    margin-top: 1.25rem;
    padding-top: 0.85rem;
    border-top: 1px dotted var(--light-color);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    font-size: 0.75rem;
  }

  :global([data-user-color-scheme="dark"]) .metrics-badges-row,
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-user-color-scheme="light"])) .metrics-badges-row {
      border-top-color: rgba(220, 205, 175, 0.2);
    }
  }

  .badges-heading {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.7rem;
    opacity: 0.8;
  }

  .venue-badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .venue-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--text-color);
    border-radius: 2px;
    font-size: 0.72rem;
    background: rgba(0, 0, 0, 0.03);
    color: var(--text-color);
  }

  :global([data-user-color-scheme="dark"]) .venue-badge,
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-user-color-scheme="light"])) .venue-badge {
      background: rgba(255, 255, 255, 0.04);
      border-color: rgba(220, 205, 175, 0.3);
    }
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--theme-color);
  }

  .badge-dot.is-live {
    background-color: #2e7d32;
  }

  .badge-dot.is-cached {
    background-color: #8d6e63;
  }

  .badge-name {
    font-weight: 600;
  }

  .badge-stat {
    opacity: 0.75;
    font-family: inherit;
  }
</style>
