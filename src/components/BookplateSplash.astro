---
// src/components/BookplateSplash.astro
---

<div id="bookplate-splash-overlay" class="bookplate-splash-overlay" aria-label="Bookplate Frontispiece">
  <div class="bookplate-stage">
    <!-- Ambient shadow on the desk underneath the leaf -->
    <div class="curl-ambient-shadow" id="curl-ambient-shadow"></div>

    <!-- The 3D flexible curling leaf -->
    <div class="bookplate-leaf" id="bookplate-leaf" role="button" tabindex="0">
      
      <!-- FRONT FACE: The Authentic Woodcut Bookplate Card -->
      <div class="leaf-face leaf-front">
        <!-- Left spine crease highlight -->
        <div class="leaf-spine-crease" aria-hidden="true"></div>

        <!-- Cylinder specular highlight sweep as the paper rolls -->
        <div class="cylinder-light-sheen" aria-hidden="true"></div>
        <!-- Cylinder crease shadow along the roll hollow -->
        <div class="cylinder-crease-shadow" aria-hidden="true"></div>

        <!-- Authentic Woodcut Ex-Libris Card -->
        <div class="ex-libris-card">
          <div class="ex-libris-outer-frame">
            <div class="ex-libris-inner-frame">
              
              <!-- Corner Rosette Ornaments -->
              <span class="corner-rosette rosette-tl">❖</span>
              <span class="corner-rosette rosette-tr">❖</span>
              <span class="corner-rosette rosette-bl">❖</span>
              <span class="corner-rosette rosette-br">❖</span>

              <!-- Top Banner & Subtitle -->
              <div class="bookplate-banner">
                <span class="banner-fleuron">❧</span>
                <span class="banner-title">PORTFOLIO & ARCHIVE</span>
                <span class="banner-fleuron">❧</span>
              </div>
              <div class="bookplate-subtitle">COLLECTED WORKS & SYSTEMS OF</div>

              <!-- Sculpted Crimson & Gold Wax Monogram Seal -->
              <div class="bookplate-seal-wrapper">
                <div class="wax-seal" aria-label="Monogram Seal HJ">
                  <div class="wax-seal-beaded-ring"></div>
                  <div class="wax-seal-inner">
                    <span class="wax-monogram">HJ</span>
                  </div>
                </div>
              </div>

              <!-- Developer Name: Authentic Ringbearer Font Stroke-by-Stroke Calligraphy -->
