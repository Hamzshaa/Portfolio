<script>
  // Automatic Realistic Page Curl Splash Controller
  const overlay = document.getElementById('bookplate-splash-overlay');
  const leaf = document.getElementById('bookplate-leaf');
  const nameContainer = document.getElementById('name-container');

  const params = new URLSearchParams(window.location.search);
  const forceSplash = params.has('splash');
  const hasSeenSplash = sessionStorage.getItem('folio_splash_seen') || localStorage.getItem('folio_splash_seen');

  let hasTurned = false;
  let autoCurlTimer: ReturnType<typeof setTimeout> | null = null;
  let unmaskTimer: ReturnType<typeof setTimeout> | null = null;

  if (hasSeenSplash && !forceSplash) {
    if (overlay) overlay.style.display = 'none';
  } else {
    // Mark as seen immediately so navigating to / never re-triggers it
    try {
      sessionStorage.setItem('folio_splash_seen', 'true');
      localStorage.setItem('folio_splash_seen', 'true');
    } catch (e) {}

    // Signal main content to prepare for the cinematic reveal
    document.body.classList.add('splash-active');

    // Trigger stroke-by-stroke calligraphy shortly after initial load
    setTimeout(() => {
      if (!hasTurned && nameContainer) {
        nameContainer.classList.add('is-inking');
        
        // Promptly open the book right as the signature finishes inking
        autoCurlTimer = setTimeout(() => {
          executePageCurl();
        }, 1400);

        // Final stroke completes at 1300ms, ensuring crystal-clear unmasking
        unmaskTimer = setTimeout(() => {
          nameContainer?.classList.add('is-inked');
        }, 1300);
      }
    }, 150);
  }

  /**
   * Execute realistic 3D page curl transition
   */
  const executePageCurl = () => {
    if (hasTurned || !overlay) return;
    hasTurned = true;

    try {
      sessionStorage.setItem('folio_splash_seen', 'true');
      localStorage.setItem('folio_splash_seen', 'true');
    } catch (e) {}

    if (autoCurlTimer) {
      clearTimeout(autoCurlTimer);
      autoCurlTimer = null;
    }
    if (unmaskTimer) {
      clearTimeout(unmaskTimer);
      unmaskTimer = null;
    }

    // Ensure name is fully inked and unmasked
    nameContainer?.classList.add('is-inking', 'is-inked');

    // Trigger the 3D realistic page curl and main content reveal
    overlay.classList.add('is-curling');
    document.body.classList.add('splash-revealing');

    // After curl animation completes (0.96s = 960ms), clean up overlay and settle page
    setTimeout(() => {
      overlay.style.display = 'none';
      document.body.classList.remove('splash-active', 'splash-revealing');
      document.body.classList.add('splash-settled');
    }, 960);
  };

  // User click or keypress anywhere instantly accelerates and curls without waiting
  const immediateSkip = () => {
    executePageCurl();
  };

  overlay?.addEventListener('click', immediateSkip);
  leaf?.addEventListener('click', (e) => {
    e.stopPropagation();
    immediateSkip();
  });

  window.addEventListener('keydown', (e) => {
    if (['Enter', ' ', 'Escape'].includes(e.key) && !hasTurned) {
      e.preventDefault();
      immediateSkip();
    }
  });

  // Replay handler for Command Palette (Ctrl+K -> Replay Bookplate Splash)
  window.addEventListener('replay-splash', () => {
    if (!overlay) return;
    document.documentElement.classList.remove('skip-splash');
    hasTurned = false;
    if (autoCurlTimer) {
      clearTimeout(autoCurlTimer);
      autoCurlTimer = null;
    }
    if (unmaskTimer) {
      clearTimeout(unmaskTimer);
      unmaskTimer = null;
    }

    overlay.style.display = 'flex';
    void overlay.offsetWidth;
    overlay.classList.remove('is-curling');
    document.body.classList.remove('splash-settled');
    document.body.classList.add('splash-active');
    
    nameContainer?.classList.remove('is-inking', 'is-inked');

    // Restart inking
    setTimeout(() => {
      nameContainer?.classList.add('is-inking');
      autoCurlTimer = setTimeout(() => {
        executePageCurl();
      }, 1400);

      unmaskTimer = setTimeout(() => {
        nameContainer?.classList.add('is-inked');
      }, 1300);
    }, 150);
  });
</script>
