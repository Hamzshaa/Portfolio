---
import Layout from '../layouts/Layout.astro';
---

<Layout
  pageTitle="Nowhere"
  pageDescription="Page not found."
  bodyClass="fourohfour utility"
>
  <Fragment slot="header">
    <p class="chapter">?</p>
    <h1 id="content">404</h1>
  </Fragment>

  <div class="container">
    <div class="content">
      <p>Unfortunately what was here is now gone. Perhaps lost to time or perhaps it was never here at all.</p>
    </div>
  </div>
</Layout>
