---
import Layout from '../layouts/Layout.astro';
import { timeline } from '../data/timeline';
---

<Layout
  pageTitle="Timeline"
  pageDescription="A chronological trail of computer science theory, startup experiments, and building software that survived real-world contact."
  pagePath="timeline"
  bodyClass="timeline"
>
  <Fragment slot="header">
    <p class="chapter">IV</p>
    <h1 id="content">Timeline</h1>
  </Fragment>

  <div class="container">
    <div class="content">
      <p>A chronological trail of computer science theory, startup experiments, and building software that survived real-world contact.</p>

      <ol class="timeline-stream unstyled">
        {timeline.map((item) => (
          <li class={`timeline-entry ${item.type}`} id={item.id}>
            {item.logo ? (
              <div class="timeline-node has-logo" aria-hidden="true" title={item.organization}>
                <img src={item.logo} alt="" class="node-logo" width="22" height="22" loading="lazy" />
              </div>
            ) : (
              <div class="timeline-node" aria-hidden="true" />
            )}
            <div class="timeline-card">
              <div class="timeline-meta">
                <time class="timeline-date">{item.year}</time>
                <span class="timeline-type">{item.type === 'work' ? 'Work' : 'Education'}</span>
              </div>

              <h2 class="timeline-title">{item.title}</h2>

              <div class="timeline-org">
                {item.url ? (
                  <a href={item.url} target="_blank" rel="noopener noreferrer" class="org-link" title={`Visit ${item.organization}`}>
                    <span class="org-name">{item.organization}</span>
                    <span class="org-arrow" aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <span class="org-name">{item.organization}</span>
                )}
                {item.location && <span class="org-loc"> · {item.location}</span>}
              </div>

              <p class="timeline-desc">{item.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</Layout>

<style>
  .timeline-stream {
    position: relative;
    margin: 2.2rem 0 0;
    padding-left: 1.75rem;
    border-left: 1px dotted var(--light-color);
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .timeline-entry {
    position: relative;
    margin: 0;
  }

  .timeline-node {
    position: absolute;
    top: 1rem;
    left: calc(-1.75rem - 4px);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--bg-color);
    border: 1.5px solid var(--text-color);
    transition: background-color 120ms ease;
  }

  .timeline-entry.education .timeline-node:not(.has-logo) {
    border-radius: 1px;
    transform: rotate(45deg);
  }

  .timeline-entry:hover .timeline-node:not(.has-logo) {
    background-color: var(--text-color);
  }

  /* Centered small logo node */
  .timeline-node.has-logo {
    top: 0.85rem;
    left: calc(-1.75rem - 13px);
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background-color: var(--bg-color);
    border: 1px solid var(--text-color);
    box-shadow: 0 0 0 3px var(--bg-color);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3px;
    overflow: hidden;
    z-index: 2;
    transition: transform 140ms ease, border-color 140ms ease;
  }

  .timeline-node.has-logo .node-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
  }

  .timeline-entry:hover .timeline-node.has-logo {
    transform: scale(1.12);
    border-color: var(--accent);
  }

  .timeline-card {
    padding: 1rem 1.2rem;
    border: 1px dotted var(--light-color);
    background-color: transparent;
    transition: border-color 120ms ease-in-out, background-color 120ms ease-in-out;
  }

  .timeline-card:hover {
    border-color: var(--text-color);
    background-color: rgba(127, 127, 127, 0.03);
  }

  .timeline-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
  }

  .timeline-date {
    font-family: 'SydoniaAtramentiquaBold', 'Times New Roman', serif;
    font-size: var(--font-sm);
    color: var(--text-color);
    letter-spacing: 0.02em;
  }

  .timeline-type {
    font-size: var(--font-xs);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    font-family: system-ui, -apple-system, sans-serif;
    font-weight: 500;
    color: var(--text-color);
    opacity: 0.6;
  }

  .timeline-title {
    margin: 0.25rem 0 0.2rem;
    font-family: 'Ringbearer', 'Cinzel', serif;
    font-weight: 700;
    letter-spacing: 0.04em;
    font-size: var(--font-md);
    line-height: 1.25;
    color: var(--text-color);
    text-transform: none;
  }

  .timeline-org {
    margin: 0 0 0.65rem;
    font-size: var(--font-sm);
    color: var(--text-color);
    opacity: 0.85;
    line-height: 1.3;
  }

  .org-name {
    font-family: 'SydoniaAtramentiquaBold', 'Times New Roman', serif;
  }

  .org-link {
    color: var(--text-color);
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 3px;
    transition: color 120ms ease;
  }

  .org-link:hover {
    color: var(--accent);
    text-decoration-style: solid;
  }

  .org-arrow {
    display: inline-block;
    font-size: 0.85em;
    margin-left: 0.2rem;
    transition: transform 120ms ease;
  }

  .org-link:hover .org-arrow {
    transform: translate(2px, -2px);
  }

  .org-loc {
    opacity: 0.8;
  }

  .timeline-desc {
    margin: 0;
    font-size: var(--font-base);
    line-height: 1.55;
    opacity: 0.95;
  }

  @media screen and (max-width: 440px) {
    .timeline-stream {
      padding-left: 1.35rem;
    }

    .timeline-node {
      left: calc(-1.35rem - 4px);
    }

    .timeline-node.has-logo {
      left: calc(-1.35rem - 13px);
    }

    .timeline-card {
      padding: 0.85rem 0.95rem;
    }

    .timeline-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.15rem;
    }
  }
</style>
