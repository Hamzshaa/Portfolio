<script>
  const dialog = document.getElementById('deployments-dialog') as HTMLDialogElement | null;
  const paper = document.getElementById('dialog-paper');
  const titleEl = document.getElementById('dialog-title');
  const badgeEl = document.getElementById('dialog-badge');
  const closeBtn = document.getElementById('dialog-close-btn');
  const footerCloseBtn = document.getElementById('dialog-footer-close-btn');
  const groups = document.querySelectorAll<HTMLElement>('.platform-group');

  let isClosing = false;

  function openDeployments(slug: string) {
    if (!dialog) return;

    groups.forEach((g) => {
      if (g.id === `group-${slug}`) {
        g.hidden = false;
        if (titleEl) titleEl.textContent = g.getAttribute('data-title') || 'Platform Deployments';
        if (badgeEl) badgeEl.textContent = g.getAttribute('data-count') || 'Live Deployments';
      } else {
        g.hidden = true;
      }
    });

    if (typeof dialog.showModal === 'function') {
      dialog.classList.remove('is-closing');
      dialog.showModal();
      document.body.classList.add('dialog-open');
      const scrollContainer = dialog.querySelector('.dialog-scroll-container');
      if (scrollContainer) scrollContainer.scrollTop = 0;
    }
  }

  function closeDeployments() {
    if (!dialog || isClosing || !dialog.open) return;
    isClosing = true;
    dialog.classList.add('is-closing');
    setTimeout(() => {
      if (typeof dialog.close === 'function') {
        dialog.close();
      }
      dialog.classList.remove('is-closing');
      document.body.classList.remove('dialog-open');
      isClosing = false;
    }, 260);
  }

  document.querySelectorAll<HTMLElement>('.trigger-deployments-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const slug = btn.getAttribute('data-project-slug');
      if (slug) openDeployments(slug);
    });
  });

  if (closeBtn) closeBtn.addEventListener('click', closeDeployments);
  if (footerCloseBtn) footerCloseBtn.addEventListener('click', closeDeployments);

  if (dialog) {
    dialog.addEventListener('click', (e) => {
      if (paper && !paper.contains(e.target as Node)) {
        closeDeployments();
      }
    });

    dialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      closeDeployments();
    });

    dialog.addEventListener('close', () => {
      document.body.classList.remove('dialog-open');
      dialog.classList.remove('is-closing');
      isClosing = false;
    });
  }
</script>
