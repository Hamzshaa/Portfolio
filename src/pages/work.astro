---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';

const multiProjects = projects.filter((p) => p.isMulti && p.deployments);
---

<Layout
  pageTitle="Work"
  pageDescription="A selected catalogue of enterprise ERP platforms, multi-tenant business systems, EdTech portals, and humanitarian operational software built by Hamza Jhad."
  pagePath="work"
  bodyClass="work"
>
  <Fragment slot="header">
    <p class="chapter">II</p>
    <h1 id="content">Work</h1>
  </Fragment>

  <p class="intro-blurb">
    A selected catalogue of production ERP platforms, retail management systems, educational portals, and humanitarian operational software. Platforms serving multiple client venues include an interactive directory of live deployments.
  </p>

  <ul class="archive-list">
    {projects.map((project) => (
      <li class={`project ${project.slug}`}>
        {project.isMulti ? (
          <button
            type="button"
            class="archive-image trigger-deployments-btn"
            data-project-slug={project.slug}
            aria-label={`View live deployments for ${project.title}`}
          >
            <img
              src={project.image}
              width="1150"
              height="700"
              alt={project.alt}
              decoding="async"
              loading="lazy"
            />
          </button>
        ) : project.url ? (
          <a
            class="archive-image"
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Visit live website for ${project.title}`}
          >
            <img
              src={project.image}
              width="1150"
              height="700"
              alt={project.alt}
              decoding="async"
              loading="lazy"
            />
          </a>
        ) : (
          <div
            class="archive-image no-link"
            aria-label={project.title}
          >
            <img
              src={project.image}
              width="1150"
              height="700"
              alt={project.alt}
              decoding="async"
              loading="lazy"
            />
          </div>
        )}

        <div class="links">
          <small>
            {project.isMulti ? (
              <button
                type="button"
                class="project-title-btn trigger-deployments-btn"
                data-project-slug={project.slug}
              >
                {project.title}
              </button>
            ) : project.url ? (
              <a href={project.url} target="_blank" rel="noopener noreferrer">
                {project.title}
              </a>
            ) : (
              <span class="project-title-static">{project.title}</span>
            )}
          </small>
          {project.isMulti ? (
            <small>
              <button
                type="button"
                class="deployment-pill-btn trigger-deployments-btn"
                data-project-slug={project.slug}
              >
                {project.deployments?.length} Deployments ▾
              </button>
            </small>
          ) : project.url ? (
            <small>
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="direct-link"
              >
                {project.displayUrl} ↗
              </a>
            </small>
          ) : null}
        </div>

        <p class="project-summary">{project.summary}</p>
        <div class="project-meta">
          <span class="category-tag">{project.category}</span>
        </div>
      </li>
    ))}
  </ul>

  <!-- Production Deployments Modal Dialog (Bookish Folio Parchment) -->
  <dialog id="deployments-dialog" class="deployments-dialog" aria-labelledby="dialog-title">
    <div class="dialog-paper" id="dialog-paper">
      <!-- Crinkle Creases & Sheen Sweeps -->
      <div class="paper-crease-overlay" aria-hidden="true"></div>
      <div class="paper-sheen-sweep" aria-hidden="true"></div>

      <!-- Bookplate Corner Rosettes -->
      <span class="paper-corner-rosette rosette-tl" aria-hidden="true">❖</span>
      <span class="paper-corner-rosette rosette-tr" aria-hidden="true">❖</span>
      <span class="paper-corner-rosette rosette-bl" aria-hidden="true">❖</span>
      <span class="paper-corner-rosette rosette-br" aria-hidden="true">❖</span>

      <div class="dialog-scroll-container">
        <!-- Folio Header -->
        <div class="dialog-header">
          <div class="dialog-header-text">
            <div class="dialog-folio-meta">
              <span class="folio-fleuron">❧</span>
              <span class="folio-label">FOLIO · PRODUCTION ARCHIVE</span>
              <span class="folio-fleuron">❧</span>
            </div>
            <h2 id="dialog-title" class="dialog-title">Platform Deployments</h2>
            <div class="dialog-badge-container">
              <span id="dialog-badge" class="dialog-badge">Live Deployments</span>
            </div>
          </div>
          <button
            type="button"
            class="dialog-close-btn"
            id="dialog-close-btn"
            aria-label="Close folio (Esc)"
            title="Close folio (Esc)"
          >
            <span class="close-symbol" aria-hidden="true">✕</span>
          </button>
        </div>

        <!-- Engraved Etched Rule -->
        <div class="folio-etched-rule" aria-hidden="true">
          <span class="rule-line"></span>
          <span class="rule-fleuron">❦</span>
          <span class="rule-line"></span>
        </div>

        <div class="dialog-content-area">
          {multiProjects.map((proj) => (
            <div
              class="platform-group"
              id={`group-${proj.slug}`}
              data-title={proj.title}
              data-count={`${proj.deployments?.length} Live Deployments`}
              hidden
            >
              <ul class="deployments-list">
                {proj.deployments?.map((dep) => (
                  <li class="deployment-row">
                    <div class="deployment-main">
                      <div class="deployment-logo-frame">
                        <img
                          src={dep.logo}
                          alt=""
                          width="34"
                          height="34"
                          class="deployment-logo-img"
                          loading="lazy"
                        />
                      </div>
                      <div class="deployment-info">
                        <span class="deployment-name">{dep.name}</span>
                        <span class="deployment-tag">{dep.tag}</span>
                      </div>
                    </div>
                    {dep.url && (
                      <a
                        href={dep.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="deployment-link"
                        title={`Visit ${dep.name}`}
                      >
                        <span class="link-label">{dep.displayUrl}</span>
                        <svg
                          class="external-arrow"
                          width="11"
                          height="11"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <line x1="7" y1="17" x2="17" y2="7" />
                          <polyline points="7 7 17 7 17 17" />
                        </svg>
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <!-- Folio Footer / Colophon -->
        <div class="dialog-footer">
          <div class="footer-colophon">
            <span class="colophon-fleuron">❧</span>
            <span class="colophon-text">VERIFIED PRODUCTION DIRECTORY</span>
            <span class="colophon-fleuron">❧</span>
          </div>
          <button type="button" class="dialog-footer-btn" id="dialog-footer-close-btn">
            <span>Close Folio</span>
            <span class="footer-btn-glyph" aria-hidden="true">✕</span>
          </button>
        </div>
      </div>
    </div>
  </dialog>
</Layout>

<style>
  .intro-blurb {
    font-size: var(--font-base);
    line-height: 1.6;
    margin-bottom: 2.5rem;
    max-width: 44rem;
  }

  .archive-list {
    display: grid;
    gap: 3rem;
  }

  .archive-list .project {
    display: flex;
    flex-direction: column;
  }

  /* Reset button styles for interactive project images */
  .archive-list button.archive-image {
    background: transparent;
    border: 1px solid var(--text-color);
    padding: 0;
    margin: 0 0 0.5rem 0;
    width: 100%;
    cursor: pointer;
    display: block;
    position: relative;
    overflow: hidden;
    text-align: left;
    font: inherit;
    color: inherit;
  }

  .archive-list button.archive-image:focus:focus-visible {
    outline: 4px solid var(--focus-color);
    outline-offset: 0;
    box-shadow: 9px 9px 0 4px var(--text-color);
  }

  .archive-list .archive-image img {
    display: block;
    width: 100%;
    height: auto;
    filter: none !important;
    transition: none !important;
  }

  /* Project title button reset */
  .archive-list button.project-title-btn {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--text-color);
    font-family: 'SydoniaAtramentiquaBold', 'Times New Roman', serif;
    text-transform: uppercase;
    font-size: inherit;
    text-align: left;
  }

  .archive-list button.project-title-btn:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-style: wavy;
  }

  /* Deployments pill button */
  .archive-list button.deployment-pill-btn {
    background: transparent;
    border: 1px solid var(--text-color);
    color: var(--text-color);
    padding: 3px 9px;
    font-family: 'SydoniaAtramentiquaBold', 'Times New Roman', serif;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: all 150ms ease-in-out;
    border-radius: 2px;
  }

  .archive-list button.deployment-pill-btn:hover {
    background: var(--text-color);
    color: var(--bg-color);
  }

  .archive-list .direct-link {
    font-family: 'SydoniaAtramentiquaBold', 'Times New Roman', serif;
    font-size: 0.95rem;
  }

  .archive-list .archive-image.no-link {
    cursor: default;
  }

  .archive-list .project-title-static {
    font-family: 'SydoniaAtramentiquaBold', 'Times New Roman', serif;
    text-transform: uppercase;
  }

  /* Project summary & category meta */
  .project-summary {
    font-size: 0.98rem;
    line-height: 1.55;
    margin: 0.65rem 0 0.4rem 0;
    opacity: 0.9;
  }

  .project-meta {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-top: 0.15rem;
  }

  .category-tag {
    font-size: 0.75rem;
    font-family: 'SydoniaAtramentiquaBold', 'Times New Roman', serif;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.65;
  }

  /* Prevent background page scroll when dialog is active */
  :global(body.dialog-open) {
    overflow: hidden;
  }

  /* Production Deployments Dialog: Authentic Antique Deckled Folio Parchment */
  .deployments-dialog {
    border: none;
    background: transparent;
    color: var(--text-color);
    padding: 0;
    max-width: 740px;
    width: calc(100vw - 2.5rem);
    max-height: 88vh;
    margin: auto;
    position: fixed;
    inset: 0;
    z-index: 1000;
    overflow: visible;
    /* Drop shadow wraps precisely around the non-rectangular deckled paper shape */
    filter: drop-shadow(0 20px 42px rgba(0, 0, 0, 0.48))
            drop-shadow(0 4px 12px rgba(0, 0, 0, 0.32));
  }

  .deployments-dialog::backdrop {
    background: radial-gradient(
      circle at center,
      rgba(15, 13, 10, 0.78) 0%,
      rgba(8, 7, 5, 0.9) 100%
    );
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    transition: opacity 0.25s ease;
  }

  .deployments-dialog.is-closing::backdrop {
    opacity: 0;
  }

  /* The Organic Non-Rectangular Deckled Paper Folio Sheet */
  .dialog-paper {
    position: relative;
    width: 100%;
    max-height: 88vh;
    display: flex;
    flex-direction: column;
    background-color: var(--bg-color);
    background-image: url("/assets/images/bg-pattern.jpg");
    background-size: 1400px auto;
    color: var(--text-color);
    transform-origin: center center;
    transform: rotate(-0.35deg);

    /* Organic Deckled Edge (Imperfect, non-rectangular handmade parchment perimeter) */
    clip-path: polygon(
      0.3% 0.8%, 7% 0.2%, 14% 0.6%, 22% 0.1%, 31% 0.5%, 39% 0.2%, 48% 0.7%, 57% 0.1%, 66% 0.5%, 75% 0.2%, 84% 0.6%, 92% 0.1%, 99.4% 0.5%,
      99.7% 6%, 99.3% 13%, 99.8% 21%, 99.4% 29%, 99.7% 38%, 99.3% 47%, 99.8% 56%, 99.4% 65%, 99.7% 74%, 99.3% 82%, 99.8% 91%, 99.5% 99.3%,
      92% 99.7%, 84% 99.3%, 75% 99.8%, 66% 99.4%, 57% 99.7%, 48% 99.2%, 39% 99.7%, 30% 99.3%, 22% 99.8%, 14% 99.4%, 6% 99.7%, 0.5% 99.2%,
      0.2% 92%, 0.7% 83%, 0.1% 74%, 0.6% 65%, 0.2% 56%, 0.7% 47%, 0.1% 38%, 0.6% 29%, 0.2% 21%, 0.7% 13%, 0.3% 6%
    );

    /* Aged edge vignette hugging the perimeter */
    box-shadow:
      inset 0 0 18px rgba(0, 0, 0, 0.15),
      inset 0 0 3px rgba(0, 0, 0, 0.35);
  }

  /* Dark mode: keep dialog deeply dark while illuminating the organic deckled paper perimeter and corners */
  :global([data-user-color-scheme="dark"]) .deployments-dialog {
    filter: drop-shadow(0 0 1.5px rgba(240, 235, 225, 0.55))
            drop-shadow(0 22px 50px rgba(0, 0, 0, 0.9));
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-user-color-scheme="light"])) .deployments-dialog {
      filter: drop-shadow(0 0 1.5px rgba(240, 235, 225, 0.55))
              drop-shadow(0 22px 50px rgba(0, 0, 0, 0.9));
    }
  }

  :global([data-user-color-scheme="dark"]) .dialog-paper {
    background-color: #121110;
    background-image: url("/assets/images/bg-pattern-dark.jpg");
    box-shadow:
      inset 0 0 28px rgba(0, 0, 0, 0.85),
      inset 0 0 2px rgba(255, 255, 255, 0.08);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-user-color-scheme="light"])) .dialog-paper {
      background-color: #121110;
      background-image: url("/assets/images/bg-pattern-dark.jpg");
      box-shadow:
        inset 0 0 28px rgba(0, 0, 0, 0.85),
        inset 0 0 2px rgba(255, 255, 255, 0.08);
    }
  }

  /* Inner Woodcut Engraved Double Frame */
  .dialog-paper::before {
    content: '';
    position: absolute;
    inset: 9px;
    border: 1.5px solid var(--text-color);
    opacity: 0.55;
    pointer-events: none;
    z-index: 1;
  }

  .dialog-paper::after {
    content: '';
    position: absolute;
    inset: 13px;
    border: 1px dashed var(--text-color);
    opacity: 0.28;
    pointer-events: none;
    z-index: 1;
  }

  /* Corner Rosettes in Inner Frame */
  .paper-corner-rosette {
    position: absolute;
    font-size: 0.8rem;
    color: var(--text-color);
    opacity: 0.6;
    pointer-events: none;
    z-index: 2;
    line-height: 1;
  }
  .rosette-tl { top: 17px; left: 17px; }
  .rosette-tr { top: 17px; right: 17px; }
  .rosette-bl { bottom: 17px; left: 17px; }
  .rosette-br { bottom: 17px; right: 17px; }

  :global([data-user-color-scheme="dark"]) .paper-corner-rosette {
    color: var(--accent);
    opacity: 0.9;
    text-shadow: 0 0 6px rgba(168, 108, 24, 0.4);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-user-color-scheme="light"])) .paper-corner-rosette {
      color: var(--accent);
      opacity: 0.9;
      text-shadow: 0 0 6px rgba(168, 108, 24, 0.4);
    }
  }

  /* CRINKLED / FOLDED PAPER OPENING ANIMATION */
  .deployments-dialog[open] .dialog-paper {
    animation: paperUnfold 0.68s cubic-bezier(0.18, 0.89, 0.32, 1.15) forwards;
  }

  .deployments-dialog.is-closing .dialog-paper {
    animation: paperFoldClose 0.26s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @keyframes paperUnfold {
    0% {
      opacity: 0;
      /* Folded crinkled pamphlet viewed in 3D perspective */
      transform: perspective(1400px) rotateX(28deg) rotateY(-18deg) rotateZ(-7deg) scale(0.66) translateY(55px);
      filter: brightness(0.9) contrast(1.18);
    }
    30% {
      /* First diagonal crease snap */
      opacity: 0.85;
      transform: perspective(1400px) rotateX(-13deg) rotateY(10deg) rotateZ(3.2deg) scale(0.86) translateY(-12px);
      filter: brightness(1.04) contrast(1.08);
    }
    60% {
      /* Cross fold expands, paper springs past resting size */
      opacity: 0.98;
      transform: perspective(1400px) rotateX(5deg) rotateY(-4deg) rotateZ(-1.4deg) scale(1.022) translateY(3px);
      filter: brightness(1.02) contrast(1.02);
    }
    82% {
      /* Gentle paper flutter recoil */
      transform: perspective(1400px) rotateX(-1.2deg) rotateY(1deg) rotateZ(-0.6deg) scale(0.996) translateY(-1px);
      filter: brightness(1) contrast(1);
    }
    100% {
      opacity: 1;
      /* Resting flush on desk with organic slight hand-cut angle */
      transform: perspective(1400px) rotateX(0deg) rotateY(0deg) rotateZ(-0.35deg) scale(1) translateY(0);
      filter: brightness(1) contrast(1);
    }
  }

  @keyframes paperFoldClose {
    0% {
      opacity: 1;
      transform: perspective(1400px) rotateX(0deg) rotateY(0deg) rotateZ(-0.35deg) scale(1) translateY(0);
    }
    100% {
      opacity: 0;
      transform: perspective(1400px) rotateX(24deg) rotateY(-14deg) rotateZ(-6deg) scale(0.72) translateY(40px);
    }
  }

  /* Paper Fold Creases & Shadow Valleys */
  .paper-crease-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    background:
      /* Horizontal tri-fold crease lines */
      linear-gradient(
        180deg,
        transparent 0%,
        transparent 32.5%,
        rgba(0, 0, 0, 0.08) 33.2%,
        rgba(255, 255, 255, 0.18) 33.6%,
        rgba(0, 0, 0, 0.12) 34.2%,
        transparent 35.5%,
        transparent 65.5%,
        rgba(0, 0, 0, 0.07) 66.2%,
        rgba(255, 255, 255, 0.16) 66.6%,
        rgba(0, 0, 0, 0.11) 67.2%,
        transparent 68.5%,
        transparent 100%
      ),
      /* Vertical center fold line */
      linear-gradient(
        90deg,
        transparent 0%,
        transparent 48.8%,
        rgba(0, 0, 0, 0.09) 49.6%,
        rgba(255, 255, 255, 0.18) 50%,
        rgba(0, 0, 0, 0.13) 50.6%,
        transparent 51.6%,
        transparent 100%
      ),
      /* Diagonal tension fold */
      linear-gradient(
        132deg,
        transparent 0%,
        transparent 24%,
        rgba(0, 0, 0, 0.06) 25.2%,
        rgba(255, 255, 255, 0.14) 25.8%,
        rgba(0, 0, 0, 0.08) 26.5%,
        transparent 28%,
        transparent 100%
      );
    mix-blend-mode: multiply;
    opacity: 0.65;
  }

  :global([data-user-color-scheme="dark"]) .paper-crease-overlay {
    mix-blend-mode: soft-light;
    opacity: 0.42;
  }

  .deployments-dialog[open] .paper-crease-overlay {
    animation: creasesFlatten 0.68s cubic-bezier(0.18, 0.89, 0.32, 1.15) forwards;
  }

  @keyframes creasesFlatten {
    0% {
      opacity: 0.95;
      transform: scale(0.92) skewX(2deg);
    }
    35% {
      opacity: 0.78;
      transform: scale(0.97) skewX(-1deg);
    }
    100% {
      opacity: 0.48;
      transform: scale(1) skewX(0deg);
    }
  }

  /* Specular Light Sheen Sweeping Across the Unfolding Paper */
  .paper-sheen-sweep {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
    background: linear-gradient(
      115deg,
      transparent 0%,
      transparent 30%,
      rgba(255, 255, 255, 0.35) 48%,
      rgba(255, 255, 255, 0.7) 50%,
      rgba(255, 255, 255, 0.25) 52%,
      transparent 70%,
      transparent 100%
    );
    background-size: 260% 100%;
    opacity: 0;
    mix-blend-mode: overlay;
  }

  .deployments-dialog[open] .paper-sheen-sweep {
    animation: sheenSweepAcross 0.7s cubic-bezier(0.2, 0.8, 0.3, 1) forwards;
  }

  @keyframes sheenSweepAcross {
    0% {
      opacity: 0;
      background-position: 130% 0;
    }
    25% {
      opacity: 0.85;
    }
    60% {
      opacity: 0.9;
      background-position: 35% 0;
    }
    100% {
      opacity: 0;
      background-position: -30% 0;
    }
  }

  /* Scrollable Interior Container */
  .dialog-scroll-container {
    overflow-y: auto;
    overflow-x: hidden;
    max-height: 88vh;
    padding: 1.7rem 1.9rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 4;
    scrollbar-width: thin;
    scrollbar-color: var(--text-color) transparent;
  }

  .deployments-dialog[open] .dialog-scroll-container {
    animation: inkReveal 0.5s ease 0.12s both;
  }

  @keyframes inkReveal {
    0% {
      opacity: 0;
      transform: translateY(10px) scale(0.98);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Custom Engraved Scrollbar */
  .dialog-scroll-container::-webkit-scrollbar {
    width: 6px;
  }

  .dialog-scroll-container::-webkit-scrollbar-track {
    background: transparent;
    margin: 1.5rem 0;
  }

  .dialog-scroll-container::-webkit-scrollbar-thumb {
    background-color: var(--text-color);
    border-radius: 1px;
    opacity: 0.7;
  }

  .dialog-scroll-container::-webkit-scrollbar-thumb:hover {
    background-color: var(--accent);
  }

  /* Folio Header */
  .dialog-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.2rem;
    padding-bottom: 0.4rem;
  }

  .dialog-folio-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: 'SydoniaAtramentiquaBold', 'Times New Roman', serif;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.72;
    color: var(--text-color);
    margin-bottom: 0.2rem;
  }

  .folio-fleuron {
    color: var(--accent);
    font-size: 0.85rem;
  }

  .dialog-title {
    font-family: 'SydoniaAtramentiquaBold', 'Cinzel', 'Times New Roman', serif;
    font-size: 1.45rem;
    line-height: 1.2;
    margin: 0;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .dialog-badge-container {
    margin-top: 0.4rem;
  }

  .dialog-badge {
